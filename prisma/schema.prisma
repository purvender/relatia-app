// use prisma-8

enum Role {
  ADMIN
  REQUESTER
  APPROVER
  FINANCE
}

enum EventStatus {
  DRAFT
  REQUESTED
  APPROVED
  VENUE_SELECTED
  BOOKING_REQUESTED
  REJECTED
  BOOKED
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

enum ProviderType {
  RESTAURANT
  HOTEL
  CLUB
  CATERING_COMPANY
  EXPERIENCE_PROVIDER
  ACTIVITY_PROVIDER
  LIVE_ENTERTAINMENT
  GIFTING_PROVIDER
  MERCHANDISE_PROVIDER
}

enum ProviderStatus {
  DRAFT
  PENDING_VERIFICATION
  VERIFIED
  PAUSED
  ARCHIVED
}

enum OnboardingStatus {
  NOT_STARTED
  IN_PROGRESS
  REVIEW_REQUIRED
  READY_FOR_DISCOVERY
  BLOCKED
  COMPLETE
}

enum VenueVisibility {
  DRAFT
  INTERNAL_ONLY
  DISCOVERABLE
  PAUSED
  ARCHIVED
}

enum BookableSpaceType {
  PRIVATE_DINING
  SEMI_PRIVATE_DINING
  LOUNGE
  TERRACE
  ROOFTOP
  BALLROOM
  BOARDROOM
  MAIN_DINING_SECTION
  CLUB_EVENT_SPACE
}

enum BookableSpaceStatus {
  DRAFT
  ACTIVE
  PAUSED
  ARCHIVED
}

enum VerificationStatus {
  UNVERIFIED
  PENDING_REVIEW
  VERIFIED
  REJECTED
}

enum OfferingType {
  SET_MENU
  PER_PERSON_PACKAGE
  FIXED_EVENT_PACKAGE
  CUSTOM_EXPERIENCE
  A_LA_CARTE_MIN_SPEND
  BEVERAGE_PACKAGE
}

enum PricingBasis {
  PER_PERSON
  FIXED_TOTAL
  MINIMUM_SPEND_ONLY
  CUSTOM_QUOTE
}

enum DocumentType {
  FSSAI_LICENSE
  GSTIN_CERTIFICATE
  LIQUOR_LICENSE
  BANK_MANDATE
  PAN_CARD
  RATE_CARD
  VENUE_FLOOR_PLAN
  OTHER
}

enum DocumentReviewStatus {
  PENDING_REVIEW
  VERIFIED
  REJECTED
  EXPIRED
}

enum ContactRoleCategory {
  OPERATIONS
  SALES
  FINANCE
  MANAGEMENT
  GENERAL
}

enum PartnerOnboardingStep {
  ACCOUNT_CREATED
  ORG_ADDED
  CONTACT_ADDED
  VENUE_ADDED
  SPACE_ADDED
  OFFERING_ADDED
  SUBMITTED
}

model Company {
  id       Int      @id @default(autoincrement())
  name     String
  slug     String   @unique
  users    User[]
  events   Event[]
  venues   Venue[]
  policies Policy[]
}

model User {
  id        Int     @id @default(autoincrement())
  clerkId   String  @unique
  email     String  @unique
  name      String
  role      Role
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  events    Event[]
  approvals Approval[]
}

model PartnerUser {
  id              Int                    @id @default(autoincrement())
  clerkId         String                 @unique
  email           String                 @unique
  name            String
  providerOrgId   Int?
  providerOrg     ProviderOrganization?  @relation(fields: [providerOrgId], references: [id])
  onboardingStep  PartnerOnboardingStep  @default(ACCOUNT_CREATED)
  submittedAt     TimestamptzString?
  acceptedAt      TimestamptzString?
  createdAt       TimestamptzString      @default(now())
  updatedAt       TimestamptzString?
}

model Event {
  id          Int         @id @default(autoincrement())
  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id])

  createdById Int
  createdBy   User        @relation(fields: [createdById], references: [id])

  title       String
  eventType   String
  purpose     String?
  city        String
  dateTime    TimestamptzString
  attendees   Int

  // Store money in paise, not rupees.
  budget      Int

  diet        String      @default("NONE")
  status      EventStatus @default(DRAFT)
  createdAt   TimestamptzString @default(now())

  approvals   Approval[]

  // One confirmed booking per event for MVP.
  booking     Booking?
}

model ProviderOrganization {
  id               Int              @id @default(autoincrement())
  name             String
  legalName        String?
  providerType     ProviderType     @default(RESTAURANT)
  city             String
  status           ProviderStatus   @default(DRAFT)
  onboardingStatus OnboardingStatus @default(NOT_STARTED)
  internalNotes    String?
  createdAt        TimestamptzString @default(now())
  updatedAt        TimestamptzString?

  venues           Venue[]
  contacts         ProviderContact[]
  documents        ProviderDocument[]
  verificationRecords VerificationRecord[]
  offerings        Offering[]
  partnerUsers     PartnerUser[]
}

model ProviderContact {
  id                     Int                 @id @default(autoincrement())
  providerOrgId          Int
  providerOrg            ProviderOrganization @relation(fields: [providerOrgId], references: [id])

  name                   String
  role                   String
  email                  String
  phone                  String?
  preferredContactMethod String              @default("EMAIL")
  category               ContactRoleCategory @default(GENERAL)
  isActive               Boolean             @default(true)
  internalNotes          String?
  createdAt              TimestamptzString   @default(now())
}

model ProviderDocument {
  id             Int                  @id @default(autoincrement())
  providerOrgId  Int
  providerOrg    ProviderOrganization  @relation(fields: [providerOrgId], references: [id])

  docType        DocumentType
  title          String
  fileReference  String
  reviewStatus   DocumentReviewStatus @default(PENDING_REVIEW)
  isInternalOnly Boolean              @default(true)
  internalNotes  String?
  createdAt      TimestamptzString    @default(now())
}

model VerificationRecord {
  id                 Int                @id @default(autoincrement())
  providerOrgId      Int?
  providerOrg        ProviderOrganization? @relation(fields: [providerOrgId], references: [id])

  venueId            Int?
  venue              Venue?             @relation(fields: [venueId], references: [id])

  status             VerificationStatus @default(UNVERIFIED)
  verifiedAt         TimestamptzString?
  verifiedBy         String?
  verificationSource String?
  notes              String?
  createdAt          TimestamptzString  @default(now())
}

model Venue {
  id                 Int                @id @default(autoincrement())
  companyId          Int?
  company            Company?           @relation(fields: [companyId], references: [id])

  providerOrgId      Int?
  providerOrg        ProviderOrganization? @relation(fields: [providerOrgId], references: [id])

  name               String
  city               String
  address            String?
  capacity           Int
  cuisine            String
  priceBand          String
  tags               String[]
  rating             Float
  active             Boolean            @default(true)

  venueType          String?            @default("RESTAURANT")
  locality           String?
  publicDescription  String?
  visibility         VenueVisibility    @default(DRAFT)
  isDiscoverable     Boolean            @default(false)
  verificationStatus VerificationStatus @default(UNVERIFIED)
  lastVerifiedAt     TimestamptzString?
  internalNotes      String?

  bookings           Booking[]
  bookableSpaces     BookableSpace[]
  offerings          Offering[]
  verificationRecords VerificationRecord[]
  availabilityMetadata AvailabilityMetadata?
  cancellationPolicy CancellationPolicy?
}

model BookableSpace {
  id                Int                 @id @default(autoincrement())
  venueId           Int
  venue             Venue               @relation(fields: [venueId], references: [id])

  name              String
  spaceType         BookableSpaceType   @default(PRIVATE_DINING)
  minCapacity       Int
  maxCapacity       Int
  privacyLevel      String?             @default("EXCLUSIVE")
  seatedCapacity    Int?
  standingCapacity  Int?
  publicDescription String?
  status            BookableSpaceStatus @default(DRAFT)
  isActive          Boolean             @default(true)
  internalNotes     String?
  createdAt         TimestamptzString   @default(now())

  offerings         Offering[]
  blackoutDates     BlackoutDateRange[]
}

model Offering {
  id              Int          @id @default(autoincrement())
  providerOrgId   Int?
  providerOrg     ProviderOrganization? @relation(fields: [providerOrgId], references: [id])

  venueId         Int?
  venue           Venue?       @relation(fields: [venueId], references: [id])

  bookableSpaceId Int?
  bookableSpace   BookableSpace? @relation(fields: [bookableSpaceId], references: [id])

  name            String
  offeringType    OfferingType @default(SET_MENU)
  pricingBasis    PricingBasis @default(PER_PERSON)

  // Monetary values stored in paise
  baseAmount      Int
  currency        String       @default("INR")
  minimumSpend    Int          @default(0)

  minGuests       Int?
  maxGuests       Int?
  description     String?
  dietaryNotes    String?
  pricingNotes    String?
  isCustomQuote   Boolean      @default(false)
  taxIncluded     Boolean      @default(false)
  isActive        Boolean      @default(true)
  isDiscoverable  Boolean      @default(false)
  internalNotes   String?
  createdAt       TimestamptzString @default(now())
}

model AvailabilityMetadata {
  id                         Int      @id @default(autoincrement())
  venueId                    Int      @unique
  venue                      Venue    @relation(fields: [venueId], references: [id])

  requiresManualConfirmation Boolean  @default(true)
  lastVerifiedAt             TimestamptzString?
  operatingDaysNotes         String?
  leadTimeHours              Int      @default(24)
  availabilityNotes          String?
  internalNotes              String?
  createdAt                  TimestamptzString @default(now())
}

model BlackoutDateRange {
  id              Int           @id @default(autoincrement())
  bookableSpaceId Int
  bookableSpace   BookableSpace @relation(fields: [bookableSpaceId], references: [id])

  startDate       TimestamptzString
  endDate         TimestamptzString
  reason          String?
  internalNotes   String?
  createdAt       TimestamptzString @default(now())
}

model CancellationPolicy {
  id              Int      @id @default(autoincrement())
  venueId         Int      @unique
  venue           Venue    @relation(fields: [venueId], references: [id])

  summary         String
  cutoffHours     Int      @default(48)
  cutoffNotes     String?
  depositRequired Boolean  @default(false)
  depositPercent  Int      @default(0)
  internalNotes   String?
  createdAt       TimestamptzString @default(now())
}

model Policy {
  id            Int      @id @default(autoincrement())
  companyId     Int      @unique
  company       Company  @relation(fields: [companyId], references: [id])

  // All monetary values are paise.
  maxBudget     Int
  perPersonCap  Int
  allowedCities String[]
  approverRole  Role
}

model Approval {
  id         Int            @id @default(autoincrement())
  eventId    Int
  event      Event          @relation(fields: [eventId], references: [id])

  approverId Int
  approver   User           @relation(fields: [approverId], references: [id])

  status     ApprovalStatus @default(PENDING)
  reason     String?

  @@unique([eventId, approverId])
}

model Booking {
  id              Int           @id @default(autoincrement())

  eventId         Int           @unique
  event           Event         @relation(fields: [eventId], references: [id])

  venueId         Int
  venue           Venue         @relation(fields: [venueId], references: [id])

  // Store all values in paise.
  amount          Int
  taxAmount       Int
  currency        String        @default("INR")

  paymentStatus     PaymentStatus @default(PENDING)
  razorpayOrderId   String?       @unique
  razorpayPaymentId String?       @unique
  razorpaySignature String?
  paidAt            TimestamptzString?
  createdAt         TimestamptzString @default(now())

  invoice         Invoice?
}

enum InvoiceStatus {
  ISSUED
  PAID
  CANCELLED
}

model Invoice {
  id             Int           @id @default(autoincrement())
  invoiceNumber  String        @unique

  bookingId      Int           @unique
  booking        Booking       @relation(fields: [bookingId], references: [id])

  // Store all monetary values in paise.
  baseAmount     Int
  cgstAmount     Int           @default(0)
  sgstAmount     Int           @default(0)
  igstAmount     Int           @default(0)
  totalAmount    Int

  supplierGstin  String
  recipientGstin String

  status         InvoiceStatus @default(ISSUED)
  pdfUrl         String?
  issuedAt       TimestamptzString @default(now())
}

model WebhookEventLog {
  id        Int               @id @default(autoincrement())
  eventId   String            @unique
  eventType String
  createdAt TimestamptzString @default(now())
}
