// use prisma-8

enum Role {
  ADMIN
  REQUESTER
  APPROVER
  FINANCE
}

enum EventStatus {
  DRAFT
  REQUESTED
  APPROVED
  VENUE_SELECTED
  REJECTED
  BOOKED
  COMPLETED
  CANCELLED
}

enum ApprovalStatus {
  PENDING
  APPROVED
  REJECTED
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED
}

model Company {
  id       Int      @id @default(autoincrement())
  name     String
  slug     String   @unique
  users    User[]
  events   Event[]
  venues   Venue[]
  policies Policy[]
}

model User {
  id        Int     @id @default(autoincrement())
  clerkId   String  @unique
  email     String  @unique
  name      String
  role      Role
  companyId Int?
  company   Company? @relation(fields: [companyId], references: [id])
  events    Event[]
  approvals Approval[]
}

model Event {
  id          Int         @id @default(autoincrement())
  companyId   Int
  company     Company     @relation(fields: [companyId], references: [id])

  createdById Int
  createdBy   User        @relation(fields: [createdById], references: [id])

  title       String
  eventType   String
  purpose     String?
  city        String
  dateTime    TimestamptzString
  attendees   Int

  // Store money in paise, not rupees.
  budget      Int

  diet        String      @default("NONE")
  status      EventStatus @default(DRAFT)
  createdAt   TimestamptzString @default(now())

  approvals   Approval[]

  // One confirmed booking per event for MVP.
  booking     Booking?
}

model Venue {
  id        Int      @id @default(autoincrement())
  companyId Int
  company   Company  @relation(fields: [companyId], references: [id])

  name      String
  city      String
  address   String?
  capacity  Int
  cuisine   String
  priceBand String
  tags      String[]
  rating    Float
  active    Boolean  @default(true)

  bookings  Booking[]
}

model Policy {
  id            Int      @id @default(autoincrement())
  companyId     Int      @unique
  company       Company  @relation(fields: [companyId], references: [id])

  // All monetary values are paise.
  maxBudget     Int
  perPersonCap  Int
  allowedCities String[]
  approverRole  Role
}

model Approval {
  id         Int            @id @default(autoincrement())
  eventId    Int
  event      Event          @relation(fields: [eventId], references: [id])

  approverId Int
  approver   User           @relation(fields: [approverId], references: [id])

  status     ApprovalStatus @default(PENDING)
  reason     String?

  @@unique([eventId, approverId])
}

model Booking {
  id              Int           @id @default(autoincrement())

  eventId         Int           @unique
  event           Event         @relation(fields: [eventId], references: [id])

  venueId         Int
  venue           Venue         @relation(fields: [venueId], references: [id])

  // Store all values in paise.
  amount          Int
  taxAmount       Int
  currency        String        @default("INR")

  paymentStatus   PaymentStatus @default(PENDING)
  razorpayOrderId String?       @unique
  createdAt       TimestamptzString @default(now())

  invoice         Invoice?
}

model Invoice {
  id        Int     @id @default(autoincrement())
  bookingId Int     @unique
  booking   Booking @relation(fields: [bookingId], references: [id])
  pdfUrl    String
  gstin     String
}
